# Line Manager - Environment Variables

# Database
DATABASE_URL=postgresql://username:password@host:port/database_name

# Authentication
JWT_SECRET=your-super-secret-jwt-key-here
ADMIN_EMAIL=admin@linemanager.com
ADMIN_NAME=System Administrator
# Use only in emergency and only with ENABLE_PRODUCTION_FALLBACK_LOGIN=true
FALLBACK_ADMIN_PASSWORD=

# Server
NODE_ENV=production
PORT=3001

# Optional: Use mock data for development
USE_MOCK_DATA=false

# Railway specific (auto-populated in production)
RAILWAY_STATIC_URL=
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Security flags (use with caution)
# Habilita endpoints de debug apenas em desenvolvimento
ENABLE_DEBUG_ENDPOINTS=false
# Permite migrações manuais via endpoint (apenas dev)
ALLOW_MANUAL_MIGRATIONS=false
# Permite executar SQL bruto em produção (não recomendado)
ALLOW_RAW_SQL=false
# Habilita fallback de login em produção (não recomendado)
ENABLE_PRODUCTION_FALLBACK_LOGIN=false
